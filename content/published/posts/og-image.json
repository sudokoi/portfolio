    {
      "_key": "k15",
      "_type": "block",
      "children": [
        {
          "_key": "k16",
          "_type": "span",
          "marks": [],
          "text": "Refer to the "
        },
        {
          "_key": "k18",
          "_type": "span",
          "marks": [
            "k17"
          ],
          "text": "Open Graph protocol"
        },
        {
          "_key": "k19",
          "_type": "span",
          "marks": [],
          "text": " for more details."
        }
      ],
      "markDefs": [
        {
          "_key": "k17",
