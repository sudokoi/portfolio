# Public pages build entirely from content/published and public/media.
SITE_INDEXABLE=false
# Set only for production analytics. Umami loads only when VERCEL_ENV=production.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
WEBMCP_ORIGIN_TRIAL_TOKEN=

# Sentry error monitoring: set these only in Vercel Production.
# Deployment environment is derived automatically from VERCEL_ENV.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Secret build-time token for source-map uploads. Never prefix with NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=

# Authoring/export only. Never use NEXT_PUBLIC_ for tokens.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Required for authenticated original-asset backups, including public datasets.
SANITY_READ_TOKEN=
# One-time restoration/import only, not required to build/deploy.
SANITY_WRITE_TOKEN=
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# GitHub Actions secrets: CONTENT_PUBLISH_TOKEN, CONTENT_GIT_EMAIL.
# GitHub Actions variables: SANITY_PROJECT_ID, SANITY_DATASET, CONTENT_GIT_NAME.

# Local account provisioning only; do not copy these into Vercel or Studio.
VERCEL_TOKEN=
# Team/account slug owning the Hobby project.
VERCEL_SCOPE=
CONTENT_PUBLISH_TOKEN=
CONTENT_GIT_EMAIL=
# Optional, for Cloudflare DNS configuration of sudh.online.
CLOUDFLARE_API_TOKEN=
